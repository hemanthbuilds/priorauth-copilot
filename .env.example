GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
RAGAS_MODEL=openai/gpt-oss-20b    # RAGAS judge: a separate model with its own daily budget
LIVE_EVAL=true              # background RAGAS scores; set false on the free Groq tier to save its rate limit
API_URL=http://localhost:8010
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=          # optional: free at smith.langchain.com; tracing is off if empty
LANGSMITH_PROJECT=priorauth-copilot
